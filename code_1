#include <iostream>

using namespace std;

struct Date {
    int hours = 0;
    int minutes = 0;
};

int main() {
    Date startTime;
    int addMinutes;

    cout << "Enter start hours (0-23): ";
    cin >> startTime.hours;
    cout << "Enter start minutes (0-59): ";
    cin >> startTime.minutes;
    cout << "Enter elapsed minutes: ";
    cin >> addMinutes;

    if (startTime.hours < 0 || startTime.hours >= 24 ||
        startTime.minutes < 0 || startTime.minutes >= 60 ||
        addMinutes < 0) {
        cout << "Error: Invalid input values (hours: 0..23, minutes: 0..59, elapsed >= 0)." << endl;
        return 1;
    }

    int totalMinutes = startTime.hours * 60 + startTime.minutes + addMinutes;

    Date resultTime;
    resultTime.hours = (totalMinutes / 60) % 24;
    resultTime.minutes = totalMinutes % 60;

    cout << resultTime.hours << ":" << resultTime.minutes << endl;

    cout << "Press Enter to exit...";
    cin.ignore();
    cin.get();
    return 0;
}
